{
  "name": "passvault-cloud-3",
  "private": true,
  "version": "3.1.1",
  "description": "PassVault 3.1.1 production-hardening release (existing encrypted format preserved)",
  "scripts": {
    "build": "node tools/build.mjs --production",
    "build:preview": "node tools/build.mjs",
    "verify": "node tools/verify.mjs",
    "verify:source": "node tools/verify-source.mjs",
    "verify:upgrade": "node tools/verify-upgrade.mjs",
    "test:security": "node tools/test-security-hardening.mjs",
    "test:device-only": "node tools/test-device-only-sync.mjs",
    "test:history": "node tools/test-edit-history.mjs",
    "test:recovery": "node tools/test-phase1-recovery.mjs",
    "test:phase3": "node tools/test-phase3-experience.mjs",
    "test:pwa": "node tools/test-online-pwa.mjs",
    "test:xss": "node tools/test-xss-hardening.mjs",
    "test:offline-flow": "node tools/test-offline-vault-flow.mjs",
    "test:production": "node tools/test-production-hardening.mjs",
    "test": "npm run verify:source && npm run test:security && npm run test:device-only && npm run test:history && npm run test:recovery && npm run test:phase3 && npm run test:pwa && npm run test:xss && npm run test:offline-flow && npm run test:production",
    "verify:live": "node tools/verify-live-headers.mjs"
